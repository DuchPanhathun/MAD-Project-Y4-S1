<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:src="@drawable/iconclose"
        android:layout_margin="6dp"
        android:paddingRight="50dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTING"
            android:textSize="22dp"
            android:textColor="@color/grey"
            android:fontFamily="@font/tenor_sans"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="27dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEN"
            android:textSize="22dp"
            android:fontFamily="@font/tenor_sans"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="40dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WOMAN"
            android:textSize="22dp"
            android:fontFamily="@font/tenor_sans"
            android:layout_marginTop="14dp"
            android:layout_marginLeft="60dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">


            <ImageView
                android:layout_width="90dp"
                android:layout_height="20dp"
                android:src="@drawable/line12"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="5dp" />


            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ratangle_327"
                android:layout_gravity="center"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="2dp"/> <!-- This will center it over the second image -->

        </FrameLayout>


        <ImageView
            android:layout_width="250dp"
            android:layout_height="20dp"
            android:src="@drawable/line13"
            android:layout_marginTop="5dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coats"
            android:fontFamily="@font/tenor_sans"
            android:layout_marginTop="15dp"
            android:textSize="24dp"
            android:layout_marginLeft="30dp" />

       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="Jakets"
           android:fontFamily="@font/tenor_sans"
           android:textSize="24dp"
           android:layout_marginTop="15dp"
           android:layout_marginLeft="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sweater"
            android:fontFamily="@font/tenor_sans"
            android:textSize="24dp"
            android:layout_marginTop="15dp"
            android:layout_marginLeft="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="T-Shirt"
            android:fontFamily="@font/tenor_sans"
            android:textSize="24dp"
            android:layout_marginTop="15dp"
            android:layout_marginLeft="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blazers"
            android:fontFamily="@font/tenor_sans"
            android:textSize="24dp"
            android:layout_marginTop="15dp"
            android:layout_marginLeft="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hoodies"
            android:fontFamily="@font/tenor_sans"
            android:textSize="24dp"
            android:layout_marginTop="15dp"
            android:layout_marginLeft="30dp"/>
    </LinearLayout>





</LinearLayout>