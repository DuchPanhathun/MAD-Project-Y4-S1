<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Navigation Bar (Toolbar) -->
    <include layout="@layout/toolbar_layout" />

    <TextView
        android:id="@+id/checkOut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CHECKOUT"
        android:textSize="22dp"
        android:fontFamily="@font/tenorsansregular"
        android:layout_marginTop="15dp"
        android:layout_gravity="center_horizontal"/>

    <ImageView
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:src="@drawable/line31"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SHIPPING ADDRESS"
        android:textSize="18dp"
        android:textColor="@color/grey"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="lris Watson"
        android:textSize="20dp"
        android:textColor="@color/black"
        android:layout_marginLeft="38dp"
        android:layout_marginTop="13dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="606-3727 Ullamcorper. Street"
        android:textSize="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginLeft="38dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Roseville NH 11523"
            android:textSize="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="38dp"/>
        <!-- Use RelativeLayout to place ImageView centered vertically and aligned to end -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/arrow_forward"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="30dp"/>
        </RelativeLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="(786) 713-8616"
        android:textSize="17dp"
        android:layout_marginTop="8dp"
        android:layout_marginLeft="38dp"/>

    <!-- CardView Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- New Dropdown Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:backgroundTint="@color/greyscale"
            app:cardCornerRadius="38dp"
            android:layout_marginEnd="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingRight="10dp"
                android:paddingLeft="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Add Shipping Address"
                    android:textSize="18sp"
                    android:fontFamily="@font/tenor_sans"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:padding="8dp"
                    android:layout_marginLeft="13dp"/>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/_plus"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="12dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SHIPPING METHOD"
        android:textSize="18dp"
        android:textColor="@color/grey"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"/>

    <!-- CardView Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"

        android:padding="10dp">

        <!-- New Dropdown Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:backgroundTint="@color/greyscale"
            app:cardCornerRadius="38dp"
            android:layout_marginEnd="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingRight="10dp"
                android:paddingLeft="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Pickup at Store"
                    android:textSize="18sp"
                    android:fontFamily="@font/tenor_sans"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:padding="8dp"
                    android:layout_marginLeft="13dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Free"
                    android:textSize="18sp"
                    android:fontFamily="@font/tenor_sans"
                    android:layout_gravity="center_vertical"
                    android:padding="8dp"
                    android:layout_marginRight="4dp"/>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/down_arrow"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="12dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PAYMENT METHOD"
        android:textSize="18dp"
        android:textColor="@color/grey"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"/>

    <!-- CardView Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- New Dropdown Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:backgroundTint="@color/greyscale"
            app:cardCornerRadius="38dp"
            android:layout_marginEnd="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingRight="10dp"
                android:paddingLeft="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="select payment method"
                    android:textSize="18sp"
                    android:fontFamily="@font/tenor_sans"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:padding="8dp"
                    android:layout_marginLeft="13dp"/>


                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/down_arrow"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="12dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="80dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOTAL"
            android:fontFamily="@font/tenor_sans"
            android:textSize="22dp"
            android:layout_gravity="bottom"
            android:layout_marginLeft="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$120"
            android:textSize="22dp"
            android:textColor="@color/red"
            android:layout_gravity="bottom"
            android:layout_marginLeft="240dp"/>
    </LinearLayout>
    <!-- Footer Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/black"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_alignParentBottom="true"> <!-- Align the LinearLayout to the bottom -->

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/shop_bag" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHECK OUT"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:fontFamily="@font/tenorsansregular"
                android:layout_marginLeft="40dp" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>