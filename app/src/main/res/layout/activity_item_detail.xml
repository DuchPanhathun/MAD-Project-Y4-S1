<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <include layout="@layout/toolbar_layout2"/>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/imageViewPager"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/brandNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:padding="16dp"/>

        <TextView
            android:id="@+id/typeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"/>

        <TextView
            android:id="@+id/priceTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/red"
            android:padding="16dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Colors:"
            android:textStyle="bold"
            android:padding="16dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/colorsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:padding="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sizes:"
            android:textStyle="bold"
            android:padding="16dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sizesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:padding="16dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/black"
            android:padding="20dp">
            <LinearLayout
                android:id="@+id/addToBasketContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageButton
                    android:id="@+id/purchaseButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/plus"
                    android:background="@color/black"/>

                <TextView
                    android:id="@+id/addToBasketText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Add To Basket"
                    android:layout_marginLeft="30dp"
                    android:textSize="16dp"
                    android:textColor="@color/fcfcfc"
                    android:fontFamily="@font/tenor_sans"/>

            </LinearLayout>
            <ImageButton
                android:id="@+id/favoriteButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/heart"
                android:background="@color/black"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Materials"
            android:textStyle="bold"
            android:padding="16dp"/>

        <TextView
            android:id="@+id/materialDetailTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"/>

        <TextView
            android:id="@+id/additionalCareDetailsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/careDetailsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:padding="16dp"/>

        <TextView
            android:id="@+id/deliveryDatesTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"/>
        <!--Delivery-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivery"
                android:textSize="16dp"
                android:layout_marginLeft="20dp"
                android:textStyle="bold"/>
            <!--Free Flat Rate Shipping-->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="30dp"
                    android:src="@drawable/shipping"
                    android:layout_margin="16dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Free Flat Rate Shipping"
                    android:layout_marginTop="20dp"
                    android:textSize="16dp"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/forward_image1"
                        android:layout_width="28dp"
                        android:layout_height="30dp"
                        android:src="@drawable/forward_"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="35dp"/>
                </RelativeLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/estimated_delivery_label1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estimated to be delivered on"
                android:textSize="16dp"
                android:textColor="@color/grey"
                android:layout_marginLeft="61dp"
                android:layout_marginTop="-12dp"/>
            <TextView
                android:id="@+id/delivery_date1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2024-10-16 - 2025-05-05"
                android:textSize="16dp"
                android:textColor="@color/grey"
                android:layout_marginLeft="61dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:background="@color/grey" />
        </LinearLayout>
        <!--COD Policy-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="28dp"
                android:src="@drawable/tag_"
                android:layout_margin="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COD Policy"
                android:layout_marginTop="20dp"
                android:textSize="16dp"/>


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/forward_image2"
                    android:layout_width="28dp"
                    android:layout_height="30dp"
                    android:src="@drawable/forward_"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="30dp"/>
            </RelativeLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/estimated_delivery_label2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estimated to be delivered on"
            android:textSize="16dp"
            android:textColor="@color/grey"
            android:layout_marginLeft="61dp"
            android:layout_marginTop="-12dp"/>
        <TextView
            android:id="@+id/delivery_date2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2024-10-16 - 2025-05-05"
            android:textSize="16dp"
            android:textColor="@color/grey"
            android:layout_marginLeft="61dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:background="@color/black" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="30dp"
                android:src="@drawable/refrease_"
                android:layout_margin="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Return Policy"
                android:layout_marginTop="20dp"
                android:textSize="16dp"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/forward_image3"
                    android:layout_width="28dp"
                    android:layout_height="30dp"
                    android:src="@drawable/forward_"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="30dp"/>
            </RelativeLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/estimated_delivery_label3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estimated to be delivered on"
            android:textSize="16dp"
            android:textColor="@color/grey"
            android:layout_marginLeft="61dp"
            android:layout_marginTop="-12dp"/>
        <TextView
            android:id="@+id/delivery_date3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2024-10-16 - 2025-05-05"
            android:textSize="16dp"
            android:textColor="@color/grey"
            android:layout_marginLeft="61dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:background="@color/black" />
        <TextView
            android:id="@+id/newArrivalText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You May Also Like"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/tenor_sans"
            android:layout_marginTop="25sp"
            android:layout_gravity="center_horizontal"
            />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/horizontal"
            android:layout_marginBottom="25sp"/>


        <include
            android:id="@+id/gridItemsContainer"
            layout="@layout/grid_items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <include layout="@layout/footer_layout" />
    </LinearLayout>

</ScrollView>