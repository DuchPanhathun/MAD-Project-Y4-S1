<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Header Image -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:src="@drawable/iconclose"
        android:layout_gravity="start"
        android:layout_marginBottom="16dp" />

    <!-- Cart Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="C a r t"
        android:textSize="28sp"
        android:fontFamily="@font/tenor_sans"
        android:layout_gravity="start"
        android:layout_marginBottom="16dp" />

    <!-- Item 1 Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Product Image -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="150dp"
            android:src="@drawable/retangle"
            android:layout_marginEnd="16dp" />

        <!-- Product Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

            <!-- Product Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lamerei"
                android:fontFamily="@font/tenor_sans"
                android:textSize="20dp"
                android:layout_marginBottom="4dp" />

            <!-- Product Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recycle Boucle Knit Cardigan Pink"
                android:layout_marginBottom="8dp" />

            <!-- Quantity Adjust Section -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Decrease Button -->
                <androidx.cardview.widget.CardView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    app:cardCornerRadius="20dp"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="-"
                        android:textSize="27sp" />
                </androidx.cardview.widget.CardView>

                <!-- Quantity -->
                <TextView
                    android:id="@+id/quantityTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="16sp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="10dp" />

                <!-- Increase Button -->
                <androidx.cardview.widget.CardView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    app:cardCornerRadius="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="+"
                        android:textSize="27sp" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>
            <!-- Price -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$120"
                android:textSize="16dp"
                android:textColor="@color/red"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Item 1 Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Product Image -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="150dp"
            android:src="@drawable/ratengle_344"
            android:layout_marginEnd="16dp" />

        <!-- Product Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

            <!-- Product Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lamerei"
                android:fontFamily="@font/tenor_sans"
                android:textSize="20dp"
                android:layout_marginBottom="4dp" />

            <!-- Product Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recycle Boucle Knit Cardigan Pink"
                android:layout_marginBottom="8dp" />

            <!-- Quantity Adjust Section -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Decrease Button -->
                <androidx.cardview.widget.CardView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    app:cardCornerRadius="20dp"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="-"
                        android:textSize="27sp" />
                </androidx.cardview.widget.CardView>

                <!-- Quantity -->
                <TextView
                    android:id="@+id/increaseTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="16sp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="10dp" />

                <!-- Increase Button -->
                <androidx.cardview.widget.CardView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    app:cardCornerRadius="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="+"
                        android:textSize="27sp" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Price -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$120"
                android:textSize="16dp"
                android:textColor="@color/red"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
    <!-- Separator Line -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="16dp" />

    <!-- Subtotal Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUB TOTAL"
            android:textSize="20dp"
            android:fontFamily="@font/tenor_sans"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$240"
            android:textSize="20dp"
            android:textColor="@color/red" />
    </LinearLayout>

    <!-- Shipping & Discount Info -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shipping charges, taxes, and Discount codes"
        android:textSize="16dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="are Calculated at the time of checkout."
        android:textSize="16dp" />

    <!-- Footer Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/black"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_alignParentBottom="true"> <!-- Align the LinearLayout to the bottom -->

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/shop_bag" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buy Out"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:fontFamily="@font/tenorsansregular"
                android:layout_marginLeft="40dp" />
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>