<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer circle (stroke) -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#CCCCCC" />
            <size
                android:width="40dp"
                android:height="40dp" />
        </shape>
    </item>
    <!-- Inner circle (color) -->
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list> 